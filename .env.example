# Copy to .env and fill in. Never commit .env.
ANTHROPIC_API_KEY=sk-ant-...
# MIT Parley users: use your sk-parley-... key above and uncomment this line
# ANTHROPIC_BASE_URL=https://parley.api.mit.edu
# Optional: free key from https://www.eia.gov/opendata/register.php for live monthly power prices
EIA_API_KEY=
# Optional: claude-sonnet-5-5 (default), claude-opus-5-5, claude-haiku-5-5
ANTHROPIC_MODEL=claude-sonnet-5-5
